<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Cardfile - Third-party licenses</title>
<style>
body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; border-radius: 6px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Cardfile is built on the following open source software.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li>{{name}} ({{count}})</li>{{/each}}
</ul>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
